# ---- Database ---------------------------------------------------------------
# Full Postgres connection string. Local docker-compose default works out of the box.
DATABASE_URL=postgres://gsm:gsm@localhost:5432/guardshift

# Set to "require" on hosted Postgres (e.g. Render) that enforces TLS.
PGSSLMODE=

# ---- Auth -------------------------------------------------------------------
# Secret used to sign login tokens. Generate a strong one for production:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- App --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Allow new users to self-register (they start as unassigned Officers until a
# Master/Supervisor assigns them to sites). Set to "false" to close registration.
ALLOW_REGISTRATION=true

# Directory where checkpoint photos are stored (v1: local disk).
UPLOAD_DIR=./uploads
